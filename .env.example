# Vellum environment.
# Copy this file to `.env` and adjust as needed — or just run ./setup.sh, which
# generates this file (with strong random secrets) through a guided wizard.

# ── Deployment / updates ──────────────────────────────────────────────
# APP_IMAGE is the published image used in "image mode" (the default) and is
# what Watchtower auto-updates. In "source mode" you build locally with
# `docker compose up -d --build`, which tags the build as this same name.
APP_IMAGE="maxig/vellum-oss:latest"
# Which compose profiles to bring up. Leave empty for just db+app.
#   proxy      → Caddy reverse proxy with automatic HTTPS
#   watchtower → automatic image updates
# e.g. COMPOSE_PROFILES="proxy,watchtower"
COMPOSE_PROFILES=""

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER="vellum"
POSTGRES_PASSWORD="vellum"          # CHANGE for production (setup.sh generates one)
POSTGRES_DB="vellum"
# Host port + interface for the DB (loopback only by default — not public).
POSTGRES_PORT="55432"
POSTGRES_BIND="127.0.0.1"
# Used by host-side tooling (prisma run outside Docker). Inside Docker the app
# builds its own DATABASE_URL from the POSTGRES_* vars above.
DATABASE_URL="postgresql://vellum:vellum@db:5432/vellum?schema=public"

# ── Web / networking ──────────────────────────────────────────────────
# Host port + interface for the app. With the Caddy proxy this stays on
# loopback (Caddy reaches the app over the internal network). For a plain-HTTP
# install that needs direct external access, set WEB_BIND="0.0.0.0".
WEB_PORT="3000"
WEB_BIND="127.0.0.1"

# NextAuth — MUST be a long random string in production (setup.sh generates one).
NEXTAUTH_SECRET="change-me-please-this-is-just-for-local-dev-only-please-change"
NEXTAUTH_URL="http://localhost:3000"

# Public origin used when generating links shown to candidates
APP_ORIGIN="http://localhost:3000"
# Apex used to detect public career site subdomains, e.g. <slug>.localhost
PUBLIC_DOMAIN="localhost:3000"

# ── Reverse proxy / HTTPS (only used with the "proxy" profile) ─────────
# APP_DOMAIN is where admins sign in (e.g. vellum.example.com).
# PUBLIC_DOMAIN_BARE is the apex that career-site subdomains hang off, with no
# port (e.g. example.com → acme.example.com). ACME_EMAIL receives Let's Encrypt
# expiry notices. CF_API_TOKEN is a Cloudflare API token with DNS:Edit on the
# zone — required only for wildcard career-site certs (DNS-01 challenge).
APP_DOMAIN=""
PUBLIC_DOMAIN_BARE=""
ACME_EMAIL=""
CF_API_TOKEN=""

# ── Automatic updates (only used with the "watchtower" profile) ────────
# Set WATCHTOWER_APP_ENABLE=true to let Watchtower update the app container
# (image mode only). Poll interval is in seconds (86400 = once a day).
WATCHTOWER_APP_ENABLE="false"
WATCHTOWER_POLL_INTERVAL="86400"

# ── Initial admin (used by seed) ──────────────────────────────────────
SEED_ADMIN_EMAIL="admin@vellum.local"
SEED_ADMIN_PASSWORD="vellum"
SEED_ADMIN_NAME="Maya Berg"
# false → clean install: just the admin login, then create your real workspace
# in-app. true → also seed the "goscore" demo workspace with sample data.
SEED_DEMO="true"

# ── AI — optional. When unset, AI features return high-quality mocks. ──
# Recommended: Ollama Cloud — hosted open models, generous free tier, no
# credit card to start. Create a key at https://ollama.com/settings/keys then:
#   AI_PROVIDER="ollama"
#   OLLAMA_BASE_URL="https://ollama.com"
#   OLLAMA_API_KEY="<your key>"
#   OLLAMA_MODEL="gpt-oss:120b"   # or qwen3-coder:480b, deepseek-v3.1:671b, …
# AI_PROVIDER can be anthropic, openai, or ollama. Every value here can be
# overridden per workspace later in Settings → AI & integrations.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1"
OLLAMA_API_KEY=""

# Email — optional. Per-workspace IMAP/SMTP credentials are configured from
# Settings → Email and encrypted at rest with VELLUM_SECRET (falls back to
# NEXTAUTH_SECRET). Set EMAIL_POLL_INTERVAL_MS to override the 3-minute IMAP
# poll cadence, or EMAIL_POLL_DISABLED=1 to turn the worker off entirely.
VELLUM_SECRET="change-me-please-this-is-just-for-local-dev-only-please-change"
EMAIL_POLL_INTERVAL_MS=""
EMAIL_POLL_DISABLED=""

# ── Calendar integration ─────────────────────────────────────────────
# CalDAV connections (iCloud, Fastmail, Nextcloud, etc.) don't need any
# server-side config — users add credentials directly in Settings →
# Calendar. Google and Microsoft require an OAuth app registered with
# the provider.
#
# Google Calendar
#   1. Create a project at https://console.cloud.google.com/
#   2. Enable the Google Calendar API
#   3. OAuth consent screen → External, add scopes:
#        https://www.googleapis.com/auth/calendar.events
#        https://www.googleapis.com/auth/calendar.readonly
#   4. Credentials → Create OAuth client (Web) → set redirect URI to
#        ${APP_ORIGIN}/api/calendar/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Override if your APP_ORIGIN differs from the registered redirect URI
GOOGLE_REDIRECT_URI=""

# Microsoft 365 / Outlook.com
#   1. Register an app at https://entra.microsoft.com → App registrations
#   2. Redirect URI (Web) →
#        ${APP_ORIGIN}/api/calendar/oauth/microsoft/callback
#   3. API permissions → delegated: Calendars.ReadWrite, User.Read,
#        offline_access  → grant admin consent if it's a work tenant
#   4. Generate a client secret under "Certificates & secrets"
# MICROSOFT_TENANT controls which accounts are accepted:
#   common         — work + personal (default)
#   organizations  — work only
#   consumers      — personal only
#   <tenant-id>    — single-tenant
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
MICROSOFT_REDIRECT_URI=""

# Sync worker — defaults are sensible; only override if you're tuning.
# CALENDAR_WORKER_TICK_MS — how often the worker drains the outbox queue.
# CALENDAR_FOLLOWUP_TICK_MS — how often follow-ups are recomputed per workspace.
CALENDAR_WORKER_TICK_MS=""
CALENDAR_FOLLOWUP_TICK_MS=""
